{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "b2u-plus-erp",
  "version": "0.1.5",
  "identifier": "com.b2uplus.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "b2u-plus-erp",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/malekedrees84/b2u-plus-erp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQUQ5NkUzQjZEQzQzQTQKUldTa1E5eTI0NWF0eS9TeU1qUUNiTXdzd1pTU29DUm5HbUNmbEozb29TQ2pQTHpTQTFkNHp4ZlQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}